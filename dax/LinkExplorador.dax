// ConfigExplorador: tabela de uma linha com coluna WebBaseURL (sem query/fragmento).
// Importe CodigoExplorador de excel.Compostos. Não manter SWITCH por ID.
LinkExplorador =
VAR Codigo = SELECTEDVALUE('excel Compostos'[CodigoExplorador])
VAR Ativo = SELECTEDVALUE('excel Compostos'[Ativo], FALSE())
VAR Endereco = SELECTEDVALUE(ConfigExplorador[WebBaseURL])
RETURN
    IF(
        ISBLANK(Codigo) || NOT(Ativo) || ISBLANK(Endereco),
        BLANK(),
        Endereco & "?composto=" & Codigo
    )
